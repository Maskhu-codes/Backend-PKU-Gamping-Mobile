# Ganti nama folder sesuai folder proyek di web root Laragon/XAMPP.
@baseUrl = http://localhost/pkug-onlineapi-master/index.php/api

# Tempel token hasil login di sini. Jangan commit token pribadi.
@token = <JWT-hasil-login>

###
# 1. Login
# Digunakan untuk mendapatkan JWT Token
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username=<email-atau-NIK-pasien>
&password=<password>

###
# 2. Daftar Dokter Berdasarkan Layanan (Poli)
# Menampilkan dokter spesialis untuk kode layanan tertentu
GET {{baseUrl}}/dokter/list?fs_kd_layanan=P001
Authorization: Bearer {{token}}

###
# 3. Daftar Jadwal Dokter
# Menampilkan jadwal 45 hari kedepan beserta ketersediaan kuota
GET {{baseUrl}}/jadwal/list?fs_kd_layanan=P001&fs_kd_petugas_medis=S188
Authorization: Bearer {{token}}

###
# 4. Simpan Booking Antrian
# Mengubah database. Jalankan hanya dengan data uji dan jadwal valid.
POST {{baseUrl}}/booking/simpan
Authorization: Bearer {{token}}
Content-Type: application/x-www-form-urlencoded

fs_mr=<MR-yang-cocok-dengan-token>
&fd_tgl_lahir=<YYYY-MM-DD>
&fs_kd_layanan=<kode-poli>
&fs_kd_petugas_medis=<kode-dokter>
&fn_hari=<hari-jadwal>
&fd_tgl_antrian=<tanggal-jadwal-mendatang>
&fs_kd_sesion_poli=<kode-sesi>
&fs_jam_mulai=<HH:MM>

###
# 5. Update Registrasi BPJS
# Melengkapi data nomor HP dan rujukan untuk pasien BPJS
POST {{baseUrl}}/bpjs/registrasi
Authorization: Bearer {{token}}
Content-Type: application/x-www-form-urlencoded

fs_kd_trs=<nomor-booking>
&fs_mr=<MR-yang-cocok-dengan-token>
&fs_no_hp=<nomor-telepon>
&fs_kd_identitas=<identitas-opsional>
&fs_kd_reff=<nomor-rujukan-opsional>

###
# 6. Data Beranda pasien dari identitas JWT
GET {{baseUrl}}/beranda
Authorization: Bearer {{token}}

###
# 7. Antrean aktif pasien dari identitas JWT
GET {{baseUrl}}/antrean
Authorization: Bearer {{token}}

###
# 8. Booking aktif
GET {{baseUrl}}/booking/aktif
Authorization: Bearer {{token}}

###
# 9. Riwayat pasien (MR diambil dari JWT)
GET {{baseUrl}}/riwayat/list?page=1
Authorization: Bearer {{token}}

###
# 10. Hasil radiologi pasien (MR diambil dari JWT)
GET {{baseUrl}}/penunjang/radiologi
Authorization: Bearer {{token}}

###
# 11. Daftar hasil laboratorium pasien (MR diambil dari JWT)
GET {{baseUrl}}/penunjang/laboratorium?page=1
Authorization: Bearer {{token}}

###
# 12. Detail laboratorium, hanya jika transaksi milik pasien di token
GET {{baseUrl}}/penunjang/laboratorium_detail?fs_kd_trs=<nomor-transaksi-milik-pasien>
Authorization: Bearer {{token}}
